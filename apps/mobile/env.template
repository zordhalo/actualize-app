# Create.xyz Platform Configuration
# Base URL for Create.xyz platform
EXPO_PUBLIC_BASE_URL=https://www.create.xyz

# Proxy/base URL for authentication and API requests
EXPO_PUBLIC_PROXY_BASE_URL=http://localhost:3000

# Project group ID from Create.xyz platform
EXPO_PUBLIC_PROJECT_GROUP_ID=your-project-group-id

# Host header for Create.xyz integration requests
EXPO_PUBLIC_HOST=localhost:3000

# Base URL for user content/uploads from Create.xyz
EXPO_PUBLIC_BASE_CREATE_USER_CONTENT_URL=https://ucarecdn.com

# Uploadcare/Image Upload Configuration
# Public key for Uploadcare file upload service
EXPO_PUBLIC_UPLOADCARE_PUBLIC_KEY=your-uploadcare-public-key

# Application Configuration
# Base URL of your application
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Whether this is an "Anything" app (set to "true" or "false" as JSON string)
EXPO_PUBLIC_IS_ANYTHING_APP=false

# Google Maps Configuration (optional - only needed if using maps)
# Google Maps API key for map functionality
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Error Reporting & Logging (optional - for production error tracking)
# Endpoint for sending error logs
EXPO_PUBLIC_LOGS_ENDPOINT=https://logs.create.xyz/api/errors

# Create.xyz temporary API key for error reporting
EXPO_PUBLIC_CREATE_TEMP_API_KEY=your-create-temp-api-key

# Development Server ID (optional - for development error tracking)
EXPO_PUBLIC_DEV_SERVER_ID=your-dev-server-id

# Node Environment (usually set automatically by Expo, but can be overridden)
NODE_ENV=development
