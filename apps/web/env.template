# Database Configuration
# MongoDB connection string (used for MongoDB operations)
MONGODB_URI=mongodb://localhost:27017/your-database-name

# PostgreSQL/Neon Database connection string (used for auth and primary database)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication Configuration
# Secret key for JWT token encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-key-here

# Base URL where your authentication is accessible (used for secure cookie settings)
AUTH_URL=http://localhost:3000

# CORS Configuration (optional)
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Create.xyz Platform Configuration
# API base URL for Create.xyz services
NEXT_PUBLIC_CREATE_API_BASE_URL=https://api.create.xyz

# Base URL for Create.xyz platform
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz

# Environment identifier (e.g., "PRODUCTION", "DEVELOPMENT", "STAGING")
NEXT_PUBLIC_CREATE_ENV=DEVELOPMENT

# Project group ID from Create.xyz platform
NEXT_PUBLIC_PROJECT_GROUP_ID=your-project-group-id

# Host header for Create.xyz integration requests
NEXT_PUBLIC_CREATE_HOST=localhost:3000

# Create.xyz API Key (for Stripe integration and other services)
CREATE_TEMP_API_KEY=your-create-temp-api-key

# Node Environment (usually set automatically, but can be overridden)
NODE_ENV=development
