# Database Configuration
# MongoDB connection string (used for all database operations)
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/
# For local MongoDB: mongodb://user:password@localhost:27017/database-name
MONGODB_URI=mongodb://localhost:27017/your-database-name

# Optional: Explicitly specify database name (if not in connection string)
# If not set, will be extracted from MONGODB_URI or default to 'test'
# MONGODB_DATABASE=your-database-name

# ============================================
# Clerk Authentication Configuration
# ============================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com

# Clerk Publishable Key (exposed to browser via VITE_ prefix)
# Format: pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Clerk Secret Key (server-side only, NEVER expose to browser)
# Format: sk_test_... or sk_live_...
CLERK_SECRET_KEY=sk_test_your-secret-key

# ============================================
# CORS Configuration (optional)
# ============================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001

# ============================================
# Create.xyz Platform Configuration
# ============================================
# API base URL for Create.xyz services
NEXT_PUBLIC_CREATE_API_BASE_URL=https://api.create.xyz

# Base URL for Create.xyz platform
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz

# Environment identifier (e.g., "PRODUCTION", "DEVELOPMENT", "STAGING")
NEXT_PUBLIC_CREATE_ENV=DEVELOPMENT

# Create.xyz host for integrations
NEXT_PUBLIC_CREATE_HOST=your-project.create.xyz

# Create.xyz project group ID
NEXT_PUBLIC_PROJECT_GROUP_ID=your-project-group-id
